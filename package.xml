<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ed</name>
  <version>0.0.0</version>
  <description>Environment Description (ED)</description>

  <maintainer email="reinzor@gmail.com">Rein Appeldoorn</maintainer>

  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>code_profiler</depend>
  <depend>diagnostic_updater</depend>
  <depend>ed_interfaces</depend>
  <depend>geolib2</depend>
  <depend>kdl_parser</depend>
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>orocos_kdl</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rgbd</depend>
  <depend>rgbd_interfaces</depend>
  <depend>rosconsole_bridge</depend>
  <depend>sdformat_vendor</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tinyxml2</depend>
  <depend>tue_config</depend>
  <depend>tue_serialization</depend>
  <depend>tue_serialization_interfaces</depend>
  <depend>urdf</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_clang_tidy</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>clang-format-21</test_depend>
  <test_depend>clang-tidy-21</test_depend>
  <!-- PCL propagates -fopenmp, so clang-tidy's clang frontend needs its own omp.h;
       without it every affected translation unit aborts and the lint results are bogus. -->
  <test_depend>libomp-21-dev</test_depend>
  <test_depend>tue_lint_config</test_depend>

  <doc_depend>doxygen</doc_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rosdoc config="rosdoc.yaml" />
  </export>

</package>
